# Copy this file to .env beside package.json, then add your key there.
# Create a Gemini key: https://aistudio.google.com/apikey
# Free-tier availability depends on your model, region, and account quotas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=3000

# Optional legacy OpenAI support. Gemini takes priority when both keys are set.
# DOCUMIND_API_KEY=
# DOCUMIND_MODEL=gpt-4.1-mini
